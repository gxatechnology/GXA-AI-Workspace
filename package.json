{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "test:e2e": "playwright test",
    "test:visual": "playwright test tests/e2e/ai-writer.visual.spec.ts tests/e2e/theme-export.visual.spec.ts",
    "test:route-audit": "playwright test tests/e2e/route-audit.spec.ts",
    "typecheck": "tsc --noEmit",
    "migration:status": "tsx scripts/platform-migration.ts status",
    "migration:dry-run": "tsx scripts/platform-migration.ts dry-run",
    "migration:apply": "tsx scripts/platform-migration.ts apply",
    "db:migrate:status": "tsx scripts/postgres-migration.ts status",
    "db:migrate": "tsx scripts/postgres-migration.ts apply",
    "db:migrate:json:dry-run": "tsx scripts/postgres-migration.ts import-json-dry-run",
    "db:migrate:json": "tsx scripts/postgres-migration.ts import-json",
    "security:check": "npm audit --omit=dev"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "docx": "^9.7.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.1.200",
    "pg": "^8.22.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^6.0.3",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "pg-mem": "^3.0.14",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
