# Active AI provider configuration (server only)
OPENROUTER_API_KEY=
OPENROUTER_ENABLED=true
OPENAI_ENABLED=false
GEMINI_ENABLED=false
AI_DEFAULT_PROVIDER=openrouter
AI_FALLBACK_PROVIDER=none
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=GXA AI Workspace

# Optional transactional email for password reset and email verification
RESEND_API_KEY=
AUTH_EMAIL_FROM=

# Canonical public application origin
APP_ORIGIN=https://your-production-domain.example

# Optional server-controlled OpenRouter routing policy
OPENROUTER_PROVIDER_ORDER=
OPENROUTER_ALLOW_FALLBACKS=true
OPENROUTER_DATA_COLLECTION=deny
OPENROUTER_ZDR=false
OPENROUTER_PROVIDER_SORT=
OPENROUTER_MAX_PROMPT_PRICE=
OPENROUTER_MAX_COMPLETION_PRICE=
AI_MAX_CONCURRENT_REQUESTS=3

# Retained direct-provider credentials
# Keys are required only when their corresponding enabled flag is true
OPENAI_API_KEY=
GEMINI_API_KEY=

# Production persistence
# Supabase pooled URL belongs in DATABASE_URL
# Schema migrations and one-time imports use DIRECT_DATABASE_URL
PERSISTENCE_PROVIDER=postgres
DATABASE_URL=
DIRECT_DATABASE_URL=
DATABASE_SSL=require
DATABASE_POOL_MAX=5
DATABASE_POOL_TIMEOUT_MS=10000

# Local-development JSON fallback only
# Never use JSON persistence on Vercel
GXA_DB_FILE=./db.local.json

# Required in production to encrypt recoverable webhook signing secrets
PLATFORM_ENCRYPTION_KEY=

# Razorpay server credentials
# All three are required to enable checkout
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=